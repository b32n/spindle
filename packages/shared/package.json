{
  "name": "@b32nio/spindle-shared",
  "version": "0.4.0",
  "description": "Shared utilities for Spindle (EventEmitter, collaboration)",
  "repository": {
    "type": "git",
    "url": "https://github.com/b32n/spindle.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/b32n/spindle/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.esm.js",
      "require": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./export/csv": {
      "import": "./dist/export/csv/index.esm.js",
      "require": "./dist/export/csv/index.js",
      "types": "./dist/export/csv/index.d.ts"
    },
    "./export/xlsx": {
      "import": "./dist/export/xlsx/index.esm.js",
      "require": "./dist/export/xlsx/index.js",
      "types": "./dist/export/xlsx/index.d.ts"
    },
    "./export/docx": {
      "import": "./dist/export/docx/index.esm.js",
      "require": "./dist/export/docx/index.js",
      "types": "./dist/export/docx/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .rollup.cache"
  },
  "keywords": [
    "event-emitter",
    "collaboration",
    "shared",
    "utilities"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "rollup": "^4.64.8",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
