{
  "name": "@b32nio/spindle-sheets-core",
  "version": "0.4.0",
  "description": "Core spreadsheet engine for Spindle Sheets",
  "repository": {
    "type": "git",
    "url": "https://github.com/b32n/spindle.git",
    "directory": "packages/sheets-core"
  },
  "bugs": {
    "url": "https://github.com/b32n/spindle/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./collab": {
      "import": "./dist/collab/index.esm.js",
      "require": "./dist/collab/index.js",
      "types": "./dist/collab/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .rollup.cache"
  },
  "keywords": [
    "spreadsheet",
    "sheet",
    "excel",
    "data-table"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@b32nio/spindle-shared": "^0.4.0",
    "lib0": "^0.2.119",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/jest": "^29.5.0",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "rollup": "^4.64.8",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
