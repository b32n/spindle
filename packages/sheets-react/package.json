{
  "name": "@b32nio/spindle-sheets-react",
  "version": "0.4.0",
  "description": "React components for Spindle Sheets",
  "repository": {
    "type": "git",
    "url": "https://github.com/b32n/spindle.git",
    "directory": "packages/sheets-react"
  },
  "bugs": {
    "url": "https://github.com/b32n/spindle/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .rollup.cache"
  },
  "keywords": [
    "spreadsheet",
    "sheet",
    "excel",
    "react",
    "react-component"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@b32nio/spindle-sheets-core": "^0.4.0",
    "@b32nio/spindle-shared": "^0.4.0",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.64.8",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
