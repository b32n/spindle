{
  "name": "@b32nio/spindle-slides-core",
  "version": "0.4.1",
  "description": "Core presentation editor engine for Spindle Slides",
  "repository": {
    "type": "git",
    "url": "https://github.com/b32n/spindle.git",
    "directory": "packages/slides-core"
  },
  "bugs": {
    "url": "https://github.com/b32n/spindle/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./collab": {
      "import": "./dist/collab/index.esm.js",
      "require": "./dist/collab/index.js",
      "types": "./dist/collab/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:fidelity:coverage": "jest -c jest.pptx-fidelity.config.cjs --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .rollup.cache"
  },
  "keywords": [
    "slides",
    "presentation",
    "powerpoint",
    "editor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@b32nio/spindle-io": "^0.4.1",
    "@b32nio/spindle-shared": "^0.4.1",
    "lib0": "^0.2.120",
    "prosemirror-model": "^1.25.13",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rollup": "^4.68.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
