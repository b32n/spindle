{
  "name": "spindle",
  "version": "0.4.0",
  "description": "A forever-free, open-source library that delivers the full editing experience you'd expect from commercial suites like Google Workspace or Microsoft Office, but built for developers who value performance, flexibility, and complete control over their tools.",
  "license": "MIT",
  "keywords": [
    "spreadsheet",
    "docs",
    "slides",
    "excel",
    "document",
    "presentation"
  ],
  "author": {
    "name": "b32n",
    "email": "hello@bharatnadkarni.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b32n/spindle"
  },
  "bugs": {
    "url": "https://github.com/b32n/spindle/issues"
  },
  "homepage": "https://spindle.b32n.io",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @b32nio/spindle-shared && npm run build -w @b32nio/spindle-docs-core -w @b32nio/spindle-sheets-core -w @b32nio/spindle-slides-core -w @b32nio/spindle-transport-websocket && npm run build -w @b32nio/spindle-docs-react -w @b32nio/spindle-sheets-react -w @b32nio/spindle-slides-react",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint --ext .ts,.tsx packages",
    "type-check": "npm run type-check --workspaces",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install && npm install --workspaces",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "prepare": "node scripts/hooks/install.mjs",
    "type-check:e2e": "tsc -p e2e --noEmit",
    "test:e2e:ui": "playwright test --ui",
    "docs:scenarios": "node scripts/testing/scenarios.mjs",
    "docs:scenarios:check": "node scripts/testing/scenarios.mjs --check",
    "build:demos": "vite build examples/sheets-demo && vite build examples/docs-demo && vite build examples/slides-demo",
    "test:e2e:preview": "PW_TARGET=preview playwright test --grep @smoke --project=chromium",
    "a11y:baseline": "A11Y_UPDATE=1 playwright test e2e/a11y --project=chromium --workers=1",
    "test:visual": "PW_VISUAL=1 playwright test --project=visual"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tslib": "^2.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.2.0",
    "vite": "^6.4.4",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "node scripts/hooks/pre-push.mjs"
  },
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=100",
      "node scripts/hooks/affected.mjs"
    ],
    "e2e/**/*.ts": [
      "prettier --write",
      "bash -c \"npm run type-check:e2e\""
    ],
    "playwright.config.ts": [
      "prettier --write"
    ]
  }
}
