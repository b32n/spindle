              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "שלום",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " and an Arabic word ",
