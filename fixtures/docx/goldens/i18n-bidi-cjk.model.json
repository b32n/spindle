          {
            "alignment": "justify",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Arabic (right-to-left paragraphs, bidi + rtl runs):",
                "type": "text"
              }
            ],
            "id": "block-4",
            "spaceAfter": 8,
            "type": "paragraph"
          },
          {
            "alignment": "left",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "هذا مستند اختبار لدعم الكتابة من اليمين إلى اليسار.",
                "type": "text"
              }
            ],
            "id": "block-5",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "left",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "يقيس الميناء حركة السفن كل صباح ويسجل النتائج في دفتر خاص.",
                "type": "text"
              }
            ],
            "id": "block-6",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "left",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "تُنشر جداول المد والجزر عند البوابة الشمالية.",
                "type": "text"
              }
            ],
            "id": "block-7",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "justify",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Hebrew:",
                "type": "text"
              }
            ],
            "id": "block-8",
            "spaceAfter": 8,
            "type": "paragraph"
          },
          {
            "alignment": "left",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "שלום עולם, זהו מסמך בדיקה לכתיבה מימין לשמאל.",
                "type": "text"
              }
            ],
            "id": "block-9",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "left",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "ועדת הנמל מתכנסת בכל חודש כדי לסקור את לוחות הגאות והשפל.",
                "type": "text"
              }
            ],
            "id": "block-10",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "justify",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Mixed direction in one paragraph (English inside Arabic, numbers and punctuation):",
                "type": "text"
              }
            ],
            "id": "block-11",
            "spaceAfter": 8,
            "type": "paragraph"
          },
          {
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "ميناء ",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Marguerite Harbour",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " استقبل ",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "42",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " سفينة في 2026/01/15.",
                "type": "text"
              }
            ],
            "id": "block-12",
            "spaceAfter": 10.666666666666666,
            "type": "paragraph"
          },
          {
            "alignment": "justify",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "English sentence with an embedded Hebrew word ",
