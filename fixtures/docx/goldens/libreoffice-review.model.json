            ],
            "id": "block-3",
            "level": 1,
            "styleId": "paragraph-style-1",
            "type": "heading"
          },
          {
            "alignment": "justify",
            "content": [
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Visiting vessels may moor for up to ",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "72",
                "type": "text"
              },
              {
                "commentThreadId": "thread-1",
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " hours",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " without a permit. ",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Permits are issued by the harbour office. ",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Every lighthouse keeper postponed the fog-signal schedule after several rounds of discussion. The harbour committee repainted a ledger of unpaid berth fees during the long spring inspection.",
                "type": "text"
              }
            ],
            "id": "block-4",
            "spaceAfter": 8,
            "spaceBefore": 0,
            "type": "paragraph"
          },
          {
            "alignment": "justify",
            "content": [
              {
                "commentThreadId": "thread-2",
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": "Fees are set annually",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": " by the harbour board",
                "type": "text"
              },
              {
                "fontFamily": "Liberation Sans",
                "fontSize": 11,
                "text": ". The harbour committee measured a ledger of unpaid berth fees during the long spring inspection. Local fishing crews recorded the fog-signal schedule as the tide turned.",
                "type": "text"
              }
            ],
            "id": "block-5",
            "spaceAfter": 8,
            "spaceBefore": 0,
            "type": "paragraph"
          },
          {
            "alignment": "justify",
